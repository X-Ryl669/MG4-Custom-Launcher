<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the browse list. 80dp tall: the 64dp original was hard to hit
    accurately in a moving car, and the extra height is also what makes room for a
    cover thumbnail big enough to recognise at a glance.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/mediaThumb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/media_thumb_background"
        android:scaleType="centerCrop"
        android:layout_marginEnd="14dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mediaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/mediaSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/mediaChevron"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_next"
        android:tint="@color/text_tertiary"
        android:scaleType="fitCenter"
        android:layout_marginStart="8dp"
        android:contentDescription="@null" />

</LinearLayout>
