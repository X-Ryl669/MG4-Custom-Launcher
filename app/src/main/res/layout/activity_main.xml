<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen for the MG4 SE launcher. 1778x720dp at density 1.0, with the
    stock system nav bar inset on the left and the status bar on top, so the
    usable area is roughly 1540x594dp.

    There used to be a second copy of this file under layout-w1778dp/. Keeping
    two in sync failed in exactly the way you would expect: a width fix landed
    in one and not the other, so on the car batteryCard was still 730dp wide and
    drew straight through the music card, while musicHeatingContainer was capped
    at 50% width and stopped well short of the quick-action rail. One file now
    serves every configuration.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="8dp">

    <!--
        Climate. Taller than it was, because two arc sliders side by side need the
        room and because side-by-side horizontal SeekBars sat close enough
        together to be hit by mistake. The card itself is no longer clickable:
        only hvacOpenButton opens the full HVAC page.
    -->
    <androidx.cardview.widget.CardView
        android:id="@+id/hvacCard"
        android:layout_width="@dimen/left_column_width"
        android:layout_height="285dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header: open-page button, label, power switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/hvacOpenButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Open the climate page"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_open_page" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="4dp"
                    android:text="CLIMATE"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <!--
                    Typed as a plain Switch in XML but held as a CompoundButton in
                    code: AppCompat rewrites this to SwitchCompat at inflation
                    time, which is not an android.widget.Switch.
                -->
                <Switch
                    android:id="@+id/hvacPowerSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Climate on/off" />

            </LinearLayout>

            <!-- Temperature and fan, one dial each so they cannot be confused -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <com.custom.launcher.widget.ArcSliderView
                    android:id="@+id/hvacTempDial"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:arcLabel="TEMP" />

                <com.custom.launcher.widget.ArcSliderView
                    android:id="@+id/hvacFanDial"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    app:arcLabel="FAN" />

            </LinearLayout>

            <!--
                Seat and wheel heating, moved here from a full-width card under the
                media player. Same ids and same icons as before, so the toggle
                logic in MainActivity is untouched; what changed is that segments
                for hardware this car does not have are hidden rather than shown
                doing nothing. Climate controls belong on the climate tile anyway.
            -->
            <LinearLayout
                android:id="@+id/heatingPill"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:background="@drawable/heating_pill_background">

                <LinearLayout
                    android:id="@+id/leftSeatButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/leftSeatIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_heated_seat_off"
                        android:scaleType="fitCenter"
                        android:contentDescription="Driver seat heating" />

                </LinearLayout>

                <View
                    android:id="@+id/heatingDividerLeft"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="10dp"
                    android:background="#26FFFFFF" />

                <LinearLayout
                    android:id="@+id/wheelButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/wheelIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_heated_wheel_off"
                        android:scaleType="fitCenter"
                        android:contentDescription="Steering wheel heating" />

                </LinearLayout>

                <View
                    android:id="@+id/heatingDividerRight"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="10dp"
                    android:background="#26FFFFFF" />

                <LinearLayout
                    android:id="@+id/rightSeatButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/rightSeatIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_heated_seat_off"
                        android:scaleType="fitCenter"
                        android:contentDescription="Passenger seat heating" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!--
        Energy. The stats are one line so the graph gets the height, and the tap
        target that opened vehicle settings is gone.
    -->
    <androidx.cardview.widget.CardView
        android:id="@+id/batteryCard"
        android:layout_width="@dimen/left_column_width"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hvacCard"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header: label and the gauge, side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/batteryLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="BATTERY"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/batteryRange"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="10sp"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:shadowColor="@color/battery_green"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="4"
                    android:text="283 km"
                    android:textAlignment="gravity"
                    android:textColor="@color/colorAccent"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="34dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/battery_outline"
                        android:textAlignment="center" />

                    <FrameLayout
                        android:id="@+id/batteryFillContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:padding="3dp">

                        <View
                            android:id="@+id/batteryFill"
                            android:layout_width="10dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="start"
                            android:background="@drawable/battery_fill" />

                    </FrameLayout>

                    <View
                        android:layout_width="5dp"
                        android:layout_height="16dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/battery_cap" />

                    <TextView
                        android:id="@+id/batteryPercent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal|center_vertical"
                        android:shadowColor="@color/colorPrimaryDark"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="10"
                        android:text="84%"
                        android:textAlignment="gravity"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <!-- Consumption over time: the tile's main content, so it gets the space -->
            <com.custom.launcher.energy.ConsumptionGraphView
                android:id="@+id/consumptionGraph"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="130dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/graphCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Collecting consumption data…"
                android:textColor="@color/text_tertiary"
                android:textSize="16sp" />

            <!--
                Everything numeric on one line. It used to be a 64sp SoC figure, a
                range line and a two-column power/consumption row, which between
                them left the graph 60dp.
            -->
            <TextView
                android:id="@+id/energyStatsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="9.4kW - 18.2 kWh/100km"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!--
        Music + seat heating. Fills everything between the left column and the
        quick-action rail: no percentage cap, so the player reaches the rail.
    -->
    <LinearLayout
        android:id="@+id/musicHeatingContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/hvacCard"
        app:layout_constraintEnd_toStartOf="@id/quickActionsCard"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <!-- Music Card (Takes remaining space) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/musicCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Blurred stretched background (fills gaps) -->
                <ImageView
                    android:id="@+id/albumArtBlurred"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.6" />

                <!-- Album Art Foreground (fits properly without cropping) -->
                <ImageView
                    android:id="@+id/albumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:alpha="1.0" />

                <!-- Dark overlay for better text contrast -->
                <!-- <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#0D000000" /> -->

                <!-- Browse button, floating over the album art -->
                <ImageButton
                    android:id="@+id/browseButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_browse"
                    android:tint="@color/text_primary"
                    android:scaleType="fitCenter"
                    android:padding="12dp"
                    android:contentDescription="Browse media" />

                <!-- Source label, floating over the album art -->
                <TextView
                    android:id="@+id/mediaSourceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="NOW PLAYING"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <!-- Gradient scrim at bottom for text readability -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_scrim" />

                <!-- Content overlay on top of album art -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:padding="6dp">

                    <!-- Song Info -->
                    <TextView
                        android:id="@+id/songTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/artistName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:layout_marginBottom="10dp" />

                    <!-- Progress Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <SeekBar
                            android:id="@+id/progressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@android:style/Widget.SeekBar"
                            android:progressTint="@color/text_primary"
                            android:progressBackgroundTint="#404040"
                            android:thumbTint="@color/text_primary"
                            android:splitTrack="false"
                            android:minHeight="4dp"
                            android:maxHeight="4dp"
                            android:max="100"
                            android:progress="0"
                            android:layout_marginBottom="0dp" />

                        <!-- Time Labels -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/currentTime"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="0:00"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif"
                                android:gravity="start" />

                            <TextView
                                android:id="@+id/totalTime"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="-0:00"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif"
                                android:gravity="end" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Playback Controls (smaller buttons) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/prevButton"
                            android:layout_width="85dp"
                            android:layout_height="85dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_previous"
                            android:tint="@color/text_primary"
                            android:scaleType="fitCenter"
                            android:padding="16dp"
                            android:contentDescription="Previous" />

                        <Space
                            android:layout_width="32dp"
                            android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/playPauseButton"
                            android:layout_width="95dp"
                            android:layout_height="95dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_play"
                            android:tint="@color/text_primary"
                            android:scaleType="fitCenter"
                            android:padding="14dp"
                            android:contentDescription="Play/Pause" />

                        <Space
                            android:layout_width="32dp"
                            android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/nextButton"
                            android:layout_width="85dp"
                            android:layout_height="85dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_next"
                            android:tint="@color/text_primary"
                            android:scaleType="fitCenter"
                            android:padding="16dp"
                            android:contentDescription="Next" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>
        <!--
            GPS. Took the place of the full-width heating card, whose controls
            moved onto the climate tile where they belong.

            It is also the diagnostic for the standing GPS question: it subscribes
            to updates and shows the age of the last fix, so "the position is
            frozen" and "no fix ever arrives" stop looking the same. Tapping opens
            whichever navigation app the user picked in the launcher menu — this
            car ships none, so there is nothing sensible to default to.
        -->
        <androidx.cardview.widget.CardView
            android:id="@+id/gpsCard"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_weight="0"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_gps"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="GPS position" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gpsPosition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waiting for a fix…"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/gpsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:singleLine="true"
                        android:text="GPS"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/gpsNavLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:text="Set a nav app"
                    android:textColor="@color/text_tertiary"
                    android:textSize="16sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Quick Actions Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/quickActionsCard"
        android:layout_width="110dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <!-- CarPlay Button -->
            <LinearLayout
                android:id="@+id/carPlayButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/carPlayIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_carplay_selector"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="6dp"
                    android:enabled="false" />

                <TextView
                    android:id="@+id/carPlayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CarPlay"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#30FFFFFF"
                android:layout_marginVertical="10dp" />

            <!-- Launcher settings; the Climate button here duplicated the tile. -->
            <LinearLayout
                android:id="@+id/menuButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_menu_hamburger"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="Launcher settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#30FFFFFF"
                android:layout_marginVertical="10dp" />

            <!-- Settings Button -->
            <LinearLayout
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_settings"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#30FFFFFF"
                android:layout_marginVertical="10dp" />

            <!-- Apps Button (opens the full app drawer, which pins the SAIC launcher) -->
            <LinearLayout
                android:id="@+id/appsButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_launcher"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apps"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
