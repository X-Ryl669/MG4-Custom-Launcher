<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.custom.launcher"
    android:sharedUserId="android.uid.system">

    <!-- System UID grants access to protected APIs for ADB/USB control -->

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- Bluetooth permissions for accessing album art from Bluetooth devices -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- For Android 9-12: access to external storage for album art -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- For Android 13+: granular media access -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- System permissions for ADB/USB control -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CONNECTIVITY_INTERNAL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Floating another app's window over the launcher. MANAGE_ACTIVITY_STACKS
        lets us set a task's windowing mode; REAL_GET_TASKS is what makes
        getRunningTasks report other apps' tasks rather than only our own, which is
        how the floating window is found again in order to put it away. Both are
        signature|privileged and held via the platform signature.
    -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />

    <!-- Location: reading fixes, and standing in for the absent network provider. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <uses-permission android:name="android.permission.LOCATION_HARDWARE" />
    <uses-permission android:name="android.permission.INSTALL_LOCATION_PROVIDER" />
    <!--
        Mock locations are how the relay publishes a "network" provider. The app op
        behind this normally has to be granted by picking the app in developer
        options; LocationRelayService grants it to itself instead, which works only
        because we are platform-signed and can hold MANAGE_APP_OPS_MODES.
    -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />
    <uses-permission android:name="android.permission.UPDATE_APP_OPS_STATS" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />

    <!--
        Package visibility (targetSdk 33): without these, getPackageInfo() and
        getLaunchIntentForPackage() cannot see the SAIC system apps, so trim
        detection in SaicPackages would always report "not installed".
        Both trims are listed: com.saicmotor.* is Standard/SE,
        com.saicmotor.hmi.* is Luxury/Trophy.
    -->
    <queries>
        <!-- Standard / SE (EH32) -->
        <package android:name="com.saicmotor.launcher" />
        <package android:name="com.saicmotor.hvac" />
        <package android:name="com.saicmotor.vehiclesetting" />
        <package android:name="com.saicmotor.btphone" />
        <package android:name="com.saicmotor.radio" />
        <package android:name="com.saicmotor.media" />
        <package android:name="com.saicmotor.settings" />
        <package android:name="com.saicmotor.avm" />
        <package android:name="com.saicmotor.evs" />
        <!-- Luxury / Trophy -->
        <package android:name="com.saicmotor.hmi.launcher" />
        <package android:name="com.saicmotor.hmi.hvac" />
        <package android:name="com.saicmotor.hmi.vehiclesettings" />
        <package android:name="com.saicmotor.hmi.btcall" />
        <package android:name="com.saicmotor.hmi.radio" />
        <package android:name="com.saicmotor.hmi.music" />
        <package android:name="com.saicmotor.hmi.systemsettings" />
        <package android:name="com.saicmotor.hmi.aroundview" />
        <!-- Shared between trims -->
        <package android:name="com.saicmotor.service.vehicle" />
        <package android:name="com.allgo.rui" />
        <package android:name="com.allgo.carplay.service" />
    </queries>

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:icon="@drawable/ic_launcher"
        android:label="Custom Launcher"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true">

        <!-- Main Launcher Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/AppTheme.MainActivity"
            android:windowSoftInputMode="adjustPan">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- USB Debug Activity -->
        <activity
            android:name=".UsbDebugActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Shell Command Activity -->
        <activity
            android:name=".ShellActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Log Viewer Activity -->
        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Media Browser (Bluetooth AVRCP tree + radio stations) -->
        <activity
            android:name=".MediaBrowseActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Launcher's own settings + diagnostics, from the hamburger button -->
        <activity
            android:name=".LauncherSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Live BMS property dump, for calibrating the energy tile -->
        <activity
            android:name=".BmsDebugActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- App Drawer -->
        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Media Listener Service -->
        <service
            android:name=".service.MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- IPv4 -> IPv6 ADB proxy service (0.0.0.0:35555 -> ::1:5555) -->
        <service
            android:name=".service.AdbV4ProxyService"
            android:enabled="true"
            android:exported="false" />

        <!--
            Republishes GPS fixes as a "network"/"fused" provider, because this
            trim ships neither. Toggled from the launcher menu, never automatic.
        -->
        <service
            android:name=".location.LocationRelayService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
